+/* A portable install keeps its data next to the binary in
+ * <bindir>/../share/retroarch, which is the location a distro install
+ * resolves to as well (/usr/bin/retroarch -> /usr/share/retroarch) */
+static bool frontend_unix_portable_dir(const char *sub, char *s, size_t len)
+{
+   char dir[PATH_MAX]  = {0};
+   char base[PATH_MAX] = {0};
+   size_t dir_len;
+
+   if (!fill_pathname_application_dir(dir, sizeof(dir)))
+      return false;
+
+   /* application_dir() keeps the trailing slash, drop it first so
+    * path_basedir() strips the binary directory and not that slash */
+   dir_len = strlen(dir);
+   if (dir_len > 0 && dir[dir_len - 1] == '/')
+      dir[dir_len - 1] = '\0';
+   path_basedir(dir);
+
+   fill_pathname_join_special(base, dir, "share/retroarch", sizeof(base));
+   fill_pathname_join_special(s, base, sub, len);
+
+   return path_is_directory(s);
+}
